{
    "name": "cte-kurum-portal",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
        "test:table": "npm run test:frontend",
        "build": "tsc --noEmit && vite build",
        "test:frontend": "node tests/frontend/run.mjs",
        "lint": "eslint resources/js tests/frontend --max-warnings=0",
        "format:check": "prettier --check resources/js tests/frontend tests/browser/*.mjs tools/check-bundle.mjs *.json *.mjs",
        "format": "prettier --write resources/js tests/frontend tests/browser/*.mjs tools/check-bundle.mjs *.json *.mjs",
        "test:browser": "node tests/browser/run.mjs",
        "check:bundle": "node tools/check-bundle.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^2.0",
        "@xyflow/react": "12.10.2",
        "react": "^19.0",
        "react-dom": "^19.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.64.1",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.0",
        "@types/react": "^19.0",
        "@types/react-dom": "^19.0",
        "@vitejs/plugin-react": "^4.3",
        "esbuild": "^0.25.12",
        "eslint": "^9.39.5",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^1.2",
        "prettier": "^3.9.10",
        "typescript": "^5.7",
        "typescript-eslint": "^8.71.2",
        "vite": "^6.0"
    }
}
