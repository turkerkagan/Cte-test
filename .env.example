APP_NAME="Kurum Portalı"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8012
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=cte
DB_TABLE_PREFIX=
DB_USERNAME=
DB_PASSWORD=

# Set only on hosting, to the exact prefixed database name also used by DB_DATABASE.
CTE_HOSTED_DATABASE=

# Optional read-only legacy export connection; never used by migrations/login.
CTE_SOURCE_DB_HOST=127.0.0.1
CTE_SOURCE_DB_PORT=3306
CTE_SOURCE_DB_SOCKET=
CTE_SOURCE_DB_DATABASE=
CTE_SOURCE_DB_USERNAME=
CTE_SOURCE_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log
FILESYSTEM_DISK=local
