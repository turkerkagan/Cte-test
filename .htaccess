# Serve the Laravel public directory while the project itself lives in htdocs.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep secrets, source, backups and the archived application outside HTTP access.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|tools|vendor|node_modules|docs|deploy|scripts|eski(?:%20|\ )app)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.[a-z]+)$ - [F,L,NC]

    # The former installation URLs continue to resolve to the same application.
    RewriteRule ^portal-next/public(?:/(.*))?$ /$1 [R=302,L,NE]

    # Let public/.htaccess handle assets and Laravel routes.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\.env(?:\..*)?|\.git.*|composer\.(?:json|lock)|package(?:-lock)?\.json|artisan|phpunit\.xml)$">
        Require all denied
    </FilesMatch>
</IfModule>
