{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "types": ["vite/client"],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
